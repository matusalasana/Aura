{
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "https://aura-marketplace-api.onrender.com/api/v1/:path*"
    },
    {
      "source": "/api/auth/:path*",
      "destination": "https://aura-marketplace-api.onrender.com/api/auth/:path*"
    },
    {
      "source": "/((?!api/v1|api/auth|src|@vite|@id|@fs|@react-refresh|node_modules|assets|favicon).*)",
      "destination": "/index.html"
    }
  ]
}